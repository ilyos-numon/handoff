# 공급자: fake(API 키 불필요) 또는 qwen(Alibaba Model Studio, OpenAI 호환)
HANDOFF_PROVIDER=fake
HANDOFF_DATA_DIR=./data
# 비우면 fake 0.25 / qwen 0.40
# HANDOFF_MIN_SCORE=
HANDOFF_COLLECTION=handoff_kb
HANDOFF_LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
HANDOFF_LLM_MODEL=qwen3.7-flash
HANDOFF_LLM_API_KEY=
HANDOFF_LLM_TIMEOUT=20
HANDOFF_EMBED_MODEL=text-embedding-v4
HANDOFF_EMBED_DIM=1024
HANDOFF_SESSION_SECONDS=900
HANDOFF_SESSION_GRACE_SECONDS=30
HANDOFF_SESSIONS_PLANNED=10
