{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "handoff-demo",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-29",
  "containers": [
    {
      "class_name": "HandoffContainer",
      "image": "../../Dockerfile",
      // Build context = repository root (Dockerfile COPYs web/, src/, pyproject.toml, uv.lock).
      "image_build_context": "../..",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "HANDOFF", "class_name": "HandoffContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HandoffContainer"] }],
  "observability": { "enabled": true }
}
